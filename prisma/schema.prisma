// ===================================================================
// BUSINESS & MULTI-TENANCY CORE
// ===================================================================

model Business {
  id                      String   @id @default(cuid())
  name                    String
  legalName               String?  @map("legal_name")
  businessCode            String   @unique @map("business_code")
  email                   String?
  phone                   String?
  addressLine1            String?  @map("address_line_1")
  addressLine2            String?  @map("address_line_2")
  city                    String?
  state                   String?
  postalCode              String?  @map("postal_code")
  country                 String   @default("India")
  currency                String   @default("INR")
  currencySymbol          String   @default("₹") @map("currency_symbol")
  timezone                String   @default("Asia/Kolkata")
  financialYearStartMonth Int      @default(4) @map("financial_year_start_month")
  logoUrl                 String?  @map("logo_url")
  gstin                   String?
  pan                     String?
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relationships
  userProfiles            UserProfile[]
  roles                   Role[]
  customers               Customer[]
  suppliers               Supplier[]
  categories              Category[]
  tags                    Tag[]
  transactions            Transaction[]
  payments                Payment[]
  paymentMethods          PaymentMethod[]
  paymentAllocations      PaymentAllocation[]
  notes                   Note[]
  attachments             Attachment[]
  importBatches           ImportBatch[]
  financialPeriods        FinancialPeriod[]
  monthlyClosings         MonthlyClosing[]
  auditLogs               AuditLog[]
  savedFilters            SavedFilter[]
  aiQueries               AIQuery[]
  reportHistories         ReportHistory[]
  settings                BusinessSetting[]
  customFieldDefinitions  CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  sequences               BusinessSequence[]
  userInvitations         UserInvitation[]
  followUps               FollowUp[]
  promises                PromiseToPay[]
  paymentCommitments      PaymentCommitment[]
  communicationLogs       CommunicationLog[]
  documentLinks           DocumentLink[]
  savedReports            SavedReport[]
  backups                 BackupRecord[]
  restoreTests            RestoreTestRecord[]

  @@map("businesses")
}

// ===================================================================
// USER MANAGEMENT & ROLE-BASED ACCESS CONTROL (RBAC)
// ===================================================================

model UserProfile {
  id           String     @id @default(cuid())
  authUserId   String     @unique @map("auth_user_id")
  businessId   String     @map("business_id")
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  displayName  String     @map("display_name")
  email        String
  phone        String?
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  lastActiveAt DateTime?  @map("last_active_at")

  userRoles         UserRole[]
  assignedFollowUps FollowUp[]         @relation("AssignedFollowUps")
  assignedCustomers Customer[]         @relation("AssignedCustomers")
  assignedSuppliers Supplier[]         @relation("AssignedSuppliers")
  communicationLogs CommunicationLog[]

  @@index([businessId, email])
  @@map("user_profiles")
}

model Role {
  id          String   @id @default(cuid())
  businessId  String?  @map("business_id")
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  type        RoleType @default(STAFF)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  userInvitations UserInvitation[]

  @@unique([businessId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String      @map("user_id")
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String      @map("role_id")
  role   Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserInvitation {
  id         String     @id @default(cuid())
  businessId String     @map("business_id")
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  roleId     String     @map("role_id")
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  token      String     @unique
  expiresAt  DateTime   @map("expires_at")
  acceptedAt DateTime?  @map("accepted_at")
  invitedBy  String?    @map("invited_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([businessId, email])
  @@map("user_invitations")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

// ===================================================================
// PARTIES: CUSTOMERS & SUPPLIERS
// ===================================================================

model Customer {
  id             String      @id @default(cuid())
  businessId     String      @map("business_id")
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerCode   String      @map("customer_code")
  name           String
  companyName    String?     @map("company_name")
  email          String?
  phone          String?
  alternatePhone String?     @map("alternate_phone")
  address        String?
  city           String?
  state          String?
  country        String      @default("India")
  postalCode     String?     @map("postal_code")
  gstin          String?
  notes          String?
  openingBalance Decimal     @default(0.0000) @db.Decimal(19, 4) @map("opening_balance")
  creditLimit    Decimal     @default(0.0000) @db.Decimal(19, 4) @map("credit_limit")
  status         PartyStatus @default(ACTIVE)
  assignedUserId String?     @map("assigned_user_id")
  assignedUser   UserProfile? @relation("AssignedCustomers", fields: [assignedUserId], references: [id], onDelete: SetNull)
  preferredContactMethod String? @map("preferred_contact_method")
  preferredContactTime   String? @map("preferred_contact_time")
  languagePreference     String? @default("en") @map("language_preference")
  tags           String[]    @default([])
  isPinnedNote   String?     @map("is_pinned_note")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  archivedAt     DateTime?   @map("archived_at")

  transactions      Transaction[]
  payments          Payment[]
  notesRel          Note[]
  followUps         FollowUp[]
  promises          PromiseToPay[]
  communicationLogs CommunicationLog[]

  @@unique([businessId, customerCode])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, assignedUserId])
  @@index([businessId, status])
  @@map("customers")
}

model Supplier {
  id             String      @id @default(cuid())
  businessId     String      @map("business_id")
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierCode   String      @map("supplier_code")
  name           String
  companyName    String?     @map("company_name")
  email          String?
  phone          String?
  alternatePhone String?     @map("alternate_phone")
  address        String?
  city           String?
  state          String?
  country        String      @default("India")
  postalCode     String?     @map("postal_code")
  gstin          String?
  notes          String?
  openingBalance Decimal     @default(0.0000) @db.Decimal(19, 4) @map("opening_balance")
  creditLimit    Decimal     @default(0.0000) @db.Decimal(19, 4) @map("credit_limit")
  status         PartyStatus @default(ACTIVE)
  assignedUserId String?     @map("assigned_user_id")
  assignedUser   UserProfile? @relation("AssignedSuppliers", fields: [assignedUserId], references: [id], onDelete: SetNull)
  preferredContactMethod String? @map("preferred_contact_method")
  preferredContactTime   String? @map("preferred_contact_time")
  languagePreference     String? @default("en") @map("language_preference")
  tags           String[]    @default([])
  isPinnedNote   String?     @map("is_pinned_note")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  archivedAt     DateTime?   @map("archived_at")

  transactions      Transaction[]
  payments          Payment[]
  notesRel          Note[]
  followUps         FollowUp[]
  commitments       PaymentCommitment[]
  communicationLogs CommunicationLog[]

  @@unique([businessId, supplierCode])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, assignedUserId])
  @@index([businessId, status])
  @@map("suppliers")
}

// ===================================================================
// CATEGORIES & TAGS
// ===================================================================

model Category {
  id          String       @id @default(cuid())
  businessId  String       @map("business_id")
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name        String
  type        CategoryType @default(BOTH)
  parentId    String?      @map("parent_id")
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]   @relation("CategoryHierarchy")
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  transactions Transaction[]

  @@unique([businessId, name, type])
  @@index([businessId, type])
  @@map("categories")
}

model Tag {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  transactionTags TransactionTag[]
  noteTags        NoteTag[]

  @@unique([businessId, name])
  @@map("tags")
}

model TransactionTag {
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String      @map("tag_id")
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

model NoteTag {
  noteId String @map("note_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id")
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

// ===================================================================
// FINANCIAL TRANSACTIONS & ITEMS
// ===================================================================

model Transaction {
  id                String            @id @default(cuid())
  businessId        String            @map("business_id")
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transactionNumber String            @map("transaction_number")
  transactionDate   DateTime          @db.Date @map("transaction_date")
  transactionTime   String?           @map("transaction_time")
  transactionType   TransactionType   @map("transaction_type")
  categoryId        String            @map("category_id")
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customerId        String?           @map("customer_id")
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId        String?           @map("supplier_id")
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  title             String
  description       String?
  referenceNumber   String?           @map("reference_number")
  currency          String            @default("INR")
  amount            Decimal           @db.Decimal(19, 4)
  taxableAmount     Decimal           @default(0.0000) @db.Decimal(19, 4) @map("taxable_amount")
  taxAmount         Decimal           @default(0.0000) @db.Decimal(19, 4) @map("tax_amount")
  discountAmount    Decimal           @default(0.0000) @db.Decimal(19, 4) @map("discount_amount")
  totalAmount       Decimal           @db.Decimal(19, 4) @map("total_amount")
  paymentStatus     PaymentStatus     @default(UNPAID) @map("payment_status")
  status            TransactionStatus @default(POSTED)
  dueDate           DateTime?         @db.Date @map("due_date")
  notes             String?
  source            String            @default("MANUAL")
  financialPeriodId String?           @map("financial_period_id")
  financialPeriod   FinancialPeriod?  @relation(fields: [financialPeriodId], references: [id], onDelete: Restrict)
  importBatchId     String?           @map("import_batch_id")
  importBatch       ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdById       String?           @map("created_by_id")
  updatedById       String?           @map("updated_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  postedAt          DateTime?         @map("posted_at")
  voidedAt          DateTime?         @map("voided_at")
  voidedBy          String?           @map("voided_by")
  voidReason        String?           @map("void_reason")
  metadata          Json?

  items             TransactionItem[]
  allocations       PaymentAllocation[]
  tags              TransactionTag[]
  notesRel          Note[]
  followUps         FollowUp[]
  promises          PromiseToPay[]
  commitments       PaymentCommitment[]

  @@unique([businessId, transactionNumber])
  @@index([businessId, transactionDate])
  @@index([businessId, transactionType, transactionDate])
  @@index([businessId, status])
  @@index([businessId, paymentStatus])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@index([businessId, categoryId])
  @@index([businessId, financialPeriodId])
  @@index([businessId, referenceNumber])
  @@map("transactions")
}

model TransactionItem {
  id             String      @id @default(cuid())
  transactionId  String      @map("transaction_id")
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  description    String
  quantity       Decimal     @default(1.000) @db.Decimal(12, 3)
  unitPrice      Decimal     @db.Decimal(19, 4) @map("unit_price")
  discountAmount Decimal     @default(0.0000) @db.Decimal(19, 4) @map("discount_amount")
  taxRate        Decimal     @default(0.00) @db.Decimal(5, 2) @map("tax_rate")
  taxAmount      Decimal     @default(0.0000) @db.Decimal(19, 4) @map("tax_amount")
  lineTotal      Decimal     @db.Decimal(19, 4) @map("line_total")
  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([transactionId])
  @@map("transaction_items")
}

// ===================================================================
// PAYMENTS & ALLOCATION ENGINE (DERIVED BALANCES)
// ===================================================================

model PaymentMethod {
  id         String            @id @default(cuid())
  businessId String            @map("business_id")
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  type       PaymentMethodType @default(UPI)
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  payments Payment[]

  @@unique([businessId, name])
  @@map("payment_methods")
}

model Payment {
  id              String            @id @default(cuid())
  businessId      String            @map("business_id")
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentNumber   String            @map("payment_number")
  paymentDate     DateTime          @db.Date @map("payment_date")
  direction       PaymentDirection
  customerId      String?           @map("customer_id")
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId      String?           @map("supplier_id")
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount          Decimal           @db.Decimal(19, 4)
  currency        String            @default("INR")
  paymentMethodId String            @map("payment_method_id")
  paymentMethod   PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  referenceNumber String?           @map("reference_number")
  notes           String?
  status          TransactionStatus @default(POSTED)
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  voidedAt        DateTime?         @map("voided_at")
  voidedBy        String?           @map("voided_by")
  voidReason      String?           @map("void_reason")

  allocations PaymentAllocation[]

  @@unique([businessId, paymentNumber])
  @@index([businessId, paymentDate])
  @@index([businessId, direction])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@map("payments")
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  businessId    String      @map("business_id")
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentId     String      @map("payment_id")
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  amount        Decimal     @db.Decimal(19, 4)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([businessId, paymentId])
  @@index([businessId, transactionId])
  @@map("payment_allocations")
}

// ===================================================================
// NOTES & DOCUMENT SYSTEM (NON-FINANCIAL BUSINESS DATA)
// ===================================================================

model Note {
  id            String       @id @default(cuid())
  businessId    String       @map("business_id")
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  title         String
  content       String
  noteType      String       @default("GENERAL") @map("note_type")
  customerId    String?      @map("customer_id")
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId    String?      @map("supplier_id")
  supplier      Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  transactionId String?      @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  isPinned      Boolean      @default(false) @map("is_pinned")
  createdById   String?      @map("created_by_id")
  updatedById   String?      @map("updated_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  archivedAt    DateTime?    @map("archived_at")

  tags NoteTag[]

  @@index([businessId, customerId])
  @@index([businessId, transactionId])
  @@map("notes")
}

// ===================================================================
// ATTACHMENTS (METADATA-FIRST OBJECT STORAGE ARCHITECTURE)
// ===================================================================

model Attachment {
  id               String               @id @default(cuid())
  businessId       String               @map("business_id")
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  entityType       AttachmentEntityType @default(GENERAL) @map("entity_type")
  entityId         String               @default("") @map("entity_id")
  fileName         String               @map("file_name")
  originalFileName String               @map("original_file_name")
  safeFileName     String               @default("") @map("safe_file_name")
  displayName      String               @default("") @map("display_name")
  storageProvider  String               @default("LOCAL") @map("storage_provider")
  storageBucket    String?              @map("storage_bucket")
  storageKey       String               @map("storage_key")
  extension        String               @default("") @map("extension")
  mimeType         String               @map("mime_type")
  declaredMimeType String?              @map("declared_mime_type")
  detectedMimeType String?              @map("detected_mime_type")
  fileSize         Int                  @map("file_size")
  checksum         String?              // SHA-256
  category         DocumentCategory     @default(GENERAL)
  sensitivity      DocumentSensitivity  @default(NORMAL)
  status           DocumentStatus       @default(AVAILABLE)
  description      String?
  expiryDate       DateTime?            @map("expiry_date")
  versionNumber    Int                  @default(1) @map("version_number")
  parentId         String?              @map("parent_id")
  parent           Attachment?          @relation("AttachmentVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions         Attachment[]         @relation("AttachmentVersions")
  changeNote       String?              @map("change_note")
  tags             String[]             @default([])
  metadata         Json?
  uploadedById     String?              @map("uploaded_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at")
  archivedAt       DateTime?            @map("archived_at")

  documentLinks    DocumentLink[]

  @@index([businessId, entityType, entityId])
  @@index([businessId, category])
  @@index([businessId, status])
  @@index([businessId, checksum])
  @@index([businessId, expiryDate])
  @@index([businessId, parentId])
  @@map("attachments")
}

model DocumentLink {
  id         String             @id @default(cuid())
  documentId String             @map("document_id")
  document   Attachment         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  businessId String             @map("business_id")
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  entityType DocumentEntityType @map("entity_type")
  entityId   String             @map("entity_id")
  createdBy  String?            @map("created_by")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([documentId, entityType, entityId])
  @@index([businessId, entityType, entityId])
  @@map("document_links")
}

// ===================================================================
// EXCEL IMPORT STAGING PIPELINE (ISOLATED BEFORE COMMIT)
// ===================================================================

model ImportBatch {
  id                   String       @id @default(cuid())
  businessId           String       @map("business_id")
  business             Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  originalFileName     String       @map("original_file_name")
  fileType             String       @map("file_type")
  status               ImportStatus @default(UPLOADED)
  totalRows            Int          @default(0) @map("total_rows")
  validRows            Int          @default(0) @map("valid_rows")
  warningRows          Int          @default(0) @map("warning_rows")
  errorRows            Int          @default(0) @map("error_rows")
  duplicateRows        Int          @default(0) @map("duplicate_rows")
  mappingConfiguration Json         @map("mapping_configuration")
  uploadedById         String?      @map("uploaded_by_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  validatedAt          DateTime?    @map("validated_at")
  committedAt          DateTime?    @map("committed_at")

  rows         ImportRow[]
  transactions Transaction[]

  @@index([businessId, status])
  @@map("import_batches")
}

model ImportRow {
  id                String          @id @default(cuid())
  importBatchId     String          @map("import_batch_id")
  batch             ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber         Int             @map("row_number")
  rawData           Json            @map("raw_data")
  normalizedData    Json?           @map("normalized_data")
  validationStatus  ImportRowStatus @default(VALID) @map("validation_status")
  validationErrors  Json?           @map("validation_errors")
  duplicateMatch    Json?           @map("duplicate_match")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([importBatchId, validationStatus])
  @@map("import_rows")
}

// ===================================================================
// FINANCIAL PERIODS & MONTH-END CLOSING (IMMUTABLE SNAPSHOTS)
// ===================================================================

model FinancialPeriod {
  id           String                @id @default(cuid())
  businessId   String                @map("business_id")
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  year         Int
  month        Int
  startDate    DateTime              @db.Date @map("start_date")
  endDate      DateTime              @db.Date @map("end_date")
  status       FinancialPeriodStatus @default(OPEN)
  openedAt     DateTime              @default(now()) @map("opened_at")
  closedAt     DateTime?             @map("closed_at")
  closedBy     String?               @map("closed_by")
  reopenedAt   DateTime?             @map("reopened_at")
  reopenedBy   String?               @map("reopened_by")
  reopenReason String?               @map("reopen_reason")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  transactions Transaction[]
  closing      MonthlyClosing?

  @@unique([businessId, year, month])
  @@index([businessId, status])
  @@map("financial_periods")
}

model MonthlyClosing {
  id                String          @id @default(cuid())
  businessId        String          @map("business_id")
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialPeriodId String          @unique @map("financial_period_id")
  financialPeriod   FinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Restrict)
  openingBalance    Decimal         @db.Decimal(19, 4) @map("opening_balance")
  totalIncome       Decimal         @db.Decimal(19, 4) @map("total_income")
  totalExpenses     Decimal         @db.Decimal(19, 4) @map("total_expenses")
  netResult         Decimal         @db.Decimal(19, 4) @map("net_result")
  closingBalance    Decimal         @db.Decimal(19, 4) @map("closing_balance")
  totalReceivables  Decimal         @db.Decimal(19, 4) @map("total_receivables")
  totalPayables     Decimal         @db.Decimal(19, 4) @map("total_payables")
  cashBalance       Decimal         @db.Decimal(19, 4) @map("cash_balance")
  bankBalance       Decimal         @db.Decimal(19, 4) @map("bank_balance")
  upiBalance        Decimal         @db.Decimal(19, 4) @map("upi_balance")
  transactionCount  Int             @map("transaction_count")
  snapshotData      Json            @map("snapshot_data")
  closedBy          String          @map("closed_by")
  closedAt          DateTime        @default(now()) @map("closed_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("monthly_closings")
}

// ===================================================================
// APPEND-ONLY AUDIT LOGS & TRACEABILITY
// ===================================================================

model AuditLog {
  id                String         @id @default(cuid())
  businessId        String         @map("business_id")
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId            String?        @map("user_id")
  actorNameSnapshot String?        @map("actor_name_snapshot")
  actorRoleSnapshot String?        @map("actor_role_snapshot")
  action            AuditAction
  category          AuditCategory  @default(FINANCIAL)
  severity          AuditSeverity  @default(INFO)
  entityType        String         @map("entity_type")
  entityId          String         @map("entity_id")
  previousValues    Json?          @map("previous_values")
  newValues         Json?          @map("new_values")
  changedFields     String[]       @default([]) @map("changed_fields")
  reason            String?
  source            String?        @default("WEB_APP")
  requestId         String?        @map("request_id")
  correlationId     String?        @map("correlation_id")
  ipAddress         String?        @map("ip_address")
  userAgent         String?        @map("user_agent")
  metadata          Json?
  previousHash      String?        @map("previous_hash")
  eventHash         String?        @map("event_hash")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([businessId, category, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([businessId, action])
  @@index([businessId, correlationId])
  @@index([businessId, createdAt])
  @@map("audit_logs")
}

// ===================================================================
// SAVED FILTERS & AI QUERY HISTORY
// ===================================================================

model SavedFilter {
  id               String   @id @default(cuid())
  businessId       String   @map("business_id")
  business         Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId           String   @map("user_id")
  name             String
  module           String
  filterDefinition Json     @map("filter_definition")
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([businessId, userId, name, module])
  @@map("saved_filters")
}

model AIQuery {
  id                String   @id @default(cuid())
  businessId        String   @map("business_id")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId            String   @map("user_id")
  originalQuery     String   @map("original_query")
  interpretedFilter Json     @map("interpreted_filter")
  actionType        String   @map("action_type")
  status            String   @default("SUCCESS")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([businessId, userId, createdAt])
  @@map("ai_queries")
}

// ===================================================================
// REPORT HISTORY
// ===================================================================

model ReportHistory {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reportType  String   @map("report_type")
  periodStart DateTime @db.Date @map("period_start")
  periodEnd   DateTime @db.Date @map("period_end")
  parameters  Json
  format      String   // 'EXCEL' | 'PDF' | 'CSV'
  storageKey  String?  @map("storage_key")
  generatedBy String?  @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([businessId, reportType, generatedAt])
  @@map("report_histories")
}

// ===================================================================
// BUSINESS SETTINGS (KEY-VALUE WITH JSON SCHEMAS)
// ===================================================================

model BusinessSetting {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  key        String
  value      Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([businessId, key])
  @@map("business_settings")
}

// ===================================================================
// CUSTOM FIELDS ENGINE (STRUCTURED METADATA EXTENSION)
// ===================================================================

model CustomFieldDefinition {
  id           String            @id @default(cuid())
  businessId   String            @map("business_id")
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  entityType   CustomFieldEntity @map("entity_type")
  fieldName    String            @map("field_name")
  fieldLabel   String            @map("field_label")
  fieldType    CustomFieldType   @map("field_type")
  options      Json?
  isRequired   Boolean           @default(false) @map("is_required")
  defaultValue String?           @map("default_value")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  values CustomFieldValue[]

  @@unique([businessId, entityType, fieldName])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  businessId   String                @map("business_id")
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  definitionId String                @map("definition_id")
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entityId     String                @map("entity_id")
  value        Json
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@unique([definitionId, entityId])
  @@index([businessId, entityId])
  @@map("custom_field_values")
}

// ===================================================================
// BUSINESS CONCURRENT NUMBER SEQUENCES (SAFE NUMBER GENERATION)
// ===================================================================

model BusinessSequence {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sequenceType String   @map("sequence_type") // 'TRANSACTION' | 'PAYMENT' | 'CUSTOMER' | 'SUPPLIER'
  prefix       String
  year         Int?
  currentValue BigInt   @default(0) @map("current_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([businessId, sequenceType, prefix, year])
  @@map("business_sequences")
}

// ===================================================================
// CRM & FOLLOW-UP MANAGEMENT SYSTEM (PHASE 12)
// ===================================================================

model FollowUp {
  id               String           @id @default(cuid())
  businessId       String           @map("business_id")
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  type             FollowUpType     @default(CUSTOMER)
  customerId       String?          @map("customer_id")
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId       String?          @map("supplier_id")
  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  transactionId    String?          @map("transaction_id")
  transaction      Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  dueDate          DateTime         @map("due_date")
  dueTime          String?          @map("due_time")
  priority         FollowUpPriority @default(NORMAL)
  status           FollowUpStatus   @default(OPEN)
  assignedUserId   String?          @map("assigned_user_id")
  assignedUser     UserProfile?     @relation("AssignedFollowUps", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy        String           @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  completedAt      DateTime?        @map("completed_at")
  outcome          FollowUpOutcome?
  outcomeNotes     String?          @map("outcome_notes")
  nextFollowUpDate DateTime?        @map("next_follow_up_date")

  promises          PromiseToPay[]
  commitments       PaymentCommitment[]
  communicationLogs CommunicationLog[]

  @@index([businessId, status, dueDate])
  @@index([businessId, assignedUserId, status])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@index([businessId, transactionId])
  @@map("follow_ups")
}

model PromiseToPay {
  id              String        @id @default(cuid())
  businessId      String        @map("business_id")
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId      String        @map("customer_id")
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactionId   String?       @map("transaction_id")
  transaction     Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  followUpId      String?       @map("follow_up_id")
  followUp        FollowUp?     @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  promisedAmount  Decimal       @db.Decimal(19, 4) @map("promised_amount")
  fulfilledAmount Decimal       @default(0.0000) @db.Decimal(19, 4) @map("fulfilled_amount")
  promiseDate     DateTime      @map("promise_date")
  notes           String?
  status          PromiseStatus @default(ACTIVE)
  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  fulfilledAt     DateTime?     @map("fulfilled_at")

  @@index([businessId, status, promiseDate])
  @@index([businessId, customerId])
  @@index([businessId, transactionId])
  @@map("promises_to_pay")
}

model PaymentCommitment {
  id             String                  @id @default(cuid())
  businessId     String                  @map("business_id")
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierId     String                  @map("supplier_id")
  supplier       Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  transactionId  String?                 @map("transaction_id")
  transaction    Transaction?            @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  followUpId     String?                 @map("follow_up_id")
  followUp       FollowUp?               @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  plannedAmount  Decimal                 @db.Decimal(19, 4) @map("planned_amount")
  paidAmount     Decimal                 @default(0.0000) @db.Decimal(19, 4) @map("paid_amount")
  commitmentDate DateTime                @map("commitment_date")
  notes          String?
  status         PaymentCommitmentStatus @default(ACTIVE)
  createdBy      String                  @map("created_by")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  fulfilledAt    DateTime?               @map("fulfilled_at")

  @@index([businessId, status, commitmentDate])
  @@index([businessId, supplierId])
  @@index([businessId, transactionId])
  @@map("payment_commitments")
}

model CommunicationLog {
  id                String                 @id @default(cuid())
  businessId        String                 @map("business_id")
  business          Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId        String?                @map("customer_id")
  customer          Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId        String?                @map("supplier_id")
  supplier          Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  channel           CommunicationChannel
  direction         CommunicationDirection @default(OUTBOUND)
  subject           String?
  summary           String
  communicationDate DateTime               @default(now()) @map("communication_date")
  userId            String                 @map("user_id")
  user              UserProfile            @relation(fields: [userId], references: [id], onDelete: Restrict)
  followUpId        String?                @map("follow_up_id")
  followUp          FollowUp?              @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now()) @map("created_at")

  @@index([businessId, customerId, communicationDate])
  @@index([businessId, supplierId, communicationDate])
  @@index([businessId, userId])
  @@map("communication_logs")
}

// ===================================================================
// SAVED CUSTOM REPORTS & REPORT BUILDER DEFINITIONS (PHASE 14)
// ===================================================================

enum ReportVisibility {
  PRIVATE
  SHARED
  RESTRICTED
}

model SavedReport {
  id             String           @id @default(cuid())
  businessId     String           @map("business_id")
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  datasetId      String           @map("dataset_id")
  periodConfig   Json             @map("period_config")
  definition     Json
  visibility     ReportVisibility @default(PRIVATE)
  allowedRoles   String[]         @default([]) @map("allowed_roles")
  allowedUserIds String[]         @default([]) @map("allowed_user_ids")
  isFavorite     Boolean          @default(false) @map("is_favorite")
  isArchived     Boolean          @default(false) @map("is_archived")
  archivedAt     DateTime?        @map("archived_at")
  versionNumber  Int              @default(1) @map("version_number")
  tags           String[]         @default([])
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  versions SavedReportVersion[]

  @@index([businessId, isArchived, createdAt])
  @@index([businessId, datasetId])
  @@index([businessId, createdById])
  @@map("saved_reports")
}

model SavedReportVersion {
  id            String      @id @default(cuid())
  reportId      String      @map("report_id")
  report        SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  versionNumber Int         @map("version_number")
  name          String
  description   String?
  datasetId     String      @map("dataset_id")
  periodConfig  Json        @map("period_config")
  definition    Json
  changeNote    String?     @map("change_note")
  savedById     String      @map("saved_by_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([reportId, versionNumber])
  @@index([reportId, createdAt])
  @@map("saved_report_versions")
}

// ===================================================================
// BACKUP MANAGEMENT & RESTORE VERIFICATION SYSTEM (PHASE 15)
// ===================================================================

model BackupRecord {
  id                 String             @id @default(cuid())
  businessId         String             @map("business_id")
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  backupType         BackupType         @default(MANUAL) @map("backup_type")
  scope              BackupScope        @default(FULL_SYSTEM)
  environment        BackupEnvironment  @default(PRODUCTION)
  status             BackupStatus       @default(COMPLETED)
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  storageLocation    String             @map("storage_location")
  sizeBytes          BigInt             @default(0) @map("size_bytes")
  checksum           String?
  providerReference  String?            @map("provider_reference")
  createdById        String?            @map("created_by_id")
  startedAt          DateTime           @default(now()) @map("started_at")
  completedAt        DateTime?          @map("completed_at")
  verifiedAt         DateTime?          @map("verified_at")
  retentionUntil     DateTime?          @map("retention_until")
  isProtected        Boolean            @default(false) @map("is_protected")
  error              String?
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  restoreTests RestoreTestRecord[]

  @@index([businessId, status, createdAt])
  @@index([businessId, verificationStatus])
  @@map("backup_records")
}

model RestoreTestRecord {
  id                       String             @id @default(cuid())
  backupId                 String             @map("backup_id")
  backup                   BackupRecord       @relation(fields: [backupId], references: [id], onDelete: Cascade)
  businessId               String             @map("business_id")
  business                 Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  environment              RestoreEnvironment @default(ISOLATED_TEST)
  status                   RestoreTestStatus  @default(PASSED)
  safetyModeActive         Boolean            @default(true) @map("safety_mode_active")
  databaseRestored         Boolean            @default(true) @map("database_restored")
  accountingReconciliation Json?              @map("accounting_reconciliation")
  monthEndVerification     Json?              @map("month_end_verification")
  documentVerification     Json?              @map("document_verification")
  auditVerification        Json?              @map("audit_verification")
  issues                   Json?
  summaryReport            String?            @db.Text @map("summary_report")
  requestedById            String?            @map("requested_by_id")
  startedAt                DateTime           @default(now()) @map("started_at")
  completedAt              DateTime?          @map("completed_at")
  createdAt                DateTime           @default(now()) @map("created_at")

  @@index([businessId, backupId, createdAt])
  @@map("restore_test_records")
}


