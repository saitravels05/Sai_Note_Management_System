# ===================================================================
# SAI NOTES & ACCOUNTING SYSTEM - ENVIRONMENT TEMPLATE
# ===================================================================
# Copy this file to .env.local for local development.
# In production, provide these via secure environment secret managers.

# Runtime Environment
NODE_ENV="development"
APP_URL="http://localhost:3000"
LOG_LEVEL="INFO"

# Database Connection (PostgreSQL 15+)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sai_accounting_db?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sai_accounting_db?schema=public"

# Authentication Security (Must be random >= 16 characters in production)
AUTH_SECRET="dev-secret-key-change-in-production-1234"

# Document & Attachment Storage
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# Provider-Independent AI Architecture Placeholder (Phase 11)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Regional & Accounting Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_NAME="Sai Tours & Travels Accounting System"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_LOCALE="en-IN"
